{
  "expo": {
    "name": "Metodista",
    "slug": "Metodista",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/metodista-app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/MetodistaLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arrudonimous.Metodista",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Permita adicionar o evento escolhido ao seu calendario. O aplicativo nao consulta seus compromissos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/metodista-app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.arrudonimous.Metodista"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      ["expo-image-picker", {
        "photosPermission": "Permita acesso a uma foto para personalizar seu perfil.",
        "cameraPermission": false,
        "microphonePermission": false
      }]
    ],
    "extra": {
      "eas": {
        "projectId": "49b12cd0-2c7e-4117-8f0b-021a93a292ae"
      }
    },
    "cli": {
      "appVersionSource": "remote"
    }
  }
}
