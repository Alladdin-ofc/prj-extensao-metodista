# Configuracao publica do app Web Firebase. Nunca colocar credenciais Admin.
EXPO_PUBLIC_FIREBASE_API_KEY=SUBSTITUIR
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=SUBSTITUIR
EXPO_PUBLIC_FIREBASE_PROJECT_ID=SUBSTITUIR
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=SUBSTITUIR
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=SUBSTITUIR
EXPO_PUBLIC_FIREBASE_APP_ID=SUBSTITUIR
# Opcional: Analytics nao e inicializado pelo aplicativo.
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
# 1 exige projeto local demo-metodista-backend. Remoto deve usar 0.
EXPO_PUBLIC_FIREBASE_EMULATORS=0
